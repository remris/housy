# Kopiere diese Datei nach .env.local und trage die Werte ein. .env.local wird nie committet.
# Lokal (npx supabase start) gibt `npx supabase status` URL und Keys aus.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig (später): Service-Role/Secret-Key für Jobs, nie im Browser verwenden
SUPABASE_SECRET_KEY=

# Basis-URL der App (Einladungs- und Passwort-Links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Geheimnis für Cron-Jobs (Vercel setzt den Header automatisch, wenn die Variable existiert)
CRON_SECRET=

# Mapbox (Kartendienst, ADR 0002)
# Server-Token für Geocoding und Fahrzeiten (nie im Browser verwenden)
MAPBOX_TOKEN=
# Öffentlicher Token für Kartenbilder; in Mapbox auf die eigenen Domains beschränken
NEXT_PUBLIC_MAPBOX_TOKEN=
# Geocoding-Ergebnisse werden gespeichert → Mapbox verlangt den "permanent"-Endpunkt.
# Nur für Tests ohne Zahlungsdaten auf false setzen.
MAPBOX_GEOCODING_PERMANENT=true
